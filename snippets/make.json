{
  "SH": {
    "prefix": "SH",
    "body": "SHELL := /data/data/com.termux/files/usr/bin/env dash"
  },
  "BASH": {
    "prefix": "BASH",
    "body": "SHELL := /data/data/com.termux/files/usr/bin/env bash"
  },
  "CC": {
    "prefix": "CC",
    "body": "CC := aarch64-linux-android-clang"
  },
  "CXX": {
    "prefix": "CXX",
    "body": "CXX := aarch64-linux-android-clang++"
  },
  "CFLAGS": {
    "prefix": "CFLAGS",
    "body": "CFLAGS := -O3 -pipe -mcpu=cortex-a55 -mtune=cortex-a55 -mlittle-endian -ffp-contract=fast -fno-semantic-interposition -fomit-frame-pointer -fstack-protector-strong -fstack-clash-protection -Qunused-arguments -flto=thin -funified-lto -fwhole-program-vtables -ffunction-sections -fdata-sections -finline-functions -finline-hint-functions -fstrict-aliasing -fstrict-enums -mharden-sls=all -mstackrealign -mstrict-align -mtls-size=12"
  },
  "CXXFLAGS": {
    "prefix": "CXXFLAGS",
    "body": "CXXFLAGS := \\$(CFLAGS) -stdlib=libc++"
  },
  "LDFLAGS": {
    "prefix": "LDFLAGS",
    "body": "LDFLAGS := -Wl,-O3,--gc-sections,--lto-O3,--build-id=fast,--enable-new-dtags,--sort-common,--as-needed,--pack-dyn-relocs=android+relr,--use-android-relr-tags,--android-memtag-heap,--android-memtag-mode=sync,--android-memtag-stack,--apply-dynamic-relocs,--enable-non-contiguous-regions,--lto-unique-basic-block-section-names,--lto-validate-all-vtables-have-type-infos,--lto-whole-program-visibility -funified-lto -ffunction-sections -fdata-sections -pipe -mcpu=cortex-a55 -mtune=cortex-a55 -Qunused-arguments -rtlib=compiler-rt -unwindlib=libunwind -fopenmp -static-openmp -fuse-ld=lld -s -L/data/data/com.termux/files/usr/local/lib"
  }
}
