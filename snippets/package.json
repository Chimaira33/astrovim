{
  "name": "friendly-snippets",
  "engines": {
    "vscode": "^1.11.0"
  },
  "contributes": {
    "snippets": [
      {
        "language": "all",
        "path": "./all.json"
      },
      {
        "language": "fish",
        "path": "./fish.json"
      },
      {
        "language": "lua",
        "path": "./lua.json"
      },
      {
        "language": "make",
        "path": "./make.json"
      },
      {
        "language": [
          "bash",
          "shellscript",
          "shell",
          "sh"
        ],
        "path": "./shell.json"
      }
    ]
  }
}
