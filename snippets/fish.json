{
  "sb": {
    "prefix": "sb",
    "body": ["#!/data/data/com.termux/files/usr/bin/env fish"]
  },
  "function": {
    "prefix": "fun",
    "body": ["function ${1:name}\nend"]
  },
  "wrap": {
    "prefix": "wrap",
    "body": ["-w \"${1:name}\""]
  },
  "switch": {
    "prefix": "swi",
    "body": "switch \"\\$${1:argv[1]}\"\ncase ${2:a}\ncase ${0:b}\nend\n"
  },
  "set": {
    "prefix": "set",
    "body": "set ${1} ${2:name} ${0:val}"
  },
  "if": {
    "prefix": "if",
    "body": "if ${1:something}\n${2:this}\nend"
  },
  "if_test": {
    "prefix": "if_test",
    "body": "if [ ${1:test} ]\nend"
  },
  "if_string": {
    "prefix": "if_string",
    "body": "if string ${1:string}\nend"
  },
  "if_set": {
    "prefix": "if_set",
    "body": "if set -q ${1:name}\nend"
  },
  "argparse": {
    "prefix": "argparse",
    "body": "argparse -isn ${1:name} ${2:a} -- \\$argv || exit\n\nif set -q _flag_a\nend"
  },
  "argparse_function": {
    "prefix": "fargparse",
    "body": "argparse -isn ${1:name} ${2:a} -- \\$argv || return\n\nif set -q _flag_a\nend"
  },
  "getopts": {
    "prefix": "getopts",
    "body": "getopts \\$argv | while read -l key value\n  switch \"\\$key\"\ncase ${1:a}\ncase ${2:b}\ncase '*'\nend\nend"
  },
  "gchoose": {
    "prefix": "gch",
    "body": "set -l choice (gch {${1:a},${2:b}})\n\nswitch \"\\$choice\"\ncase ${0:a}\ncase b\nend"
  },
  "gconfirm": {
    "prefix": "gcon",
    "body": "gcon \"${1:Confirm?}\" Yes No || return\n"
  },
  "for": {
    "prefix": "for",
    "body": "for ${1:this} in ${2:that}\nend\n"
  },
  "null": {
    "prefix": "null",
    "body": "${1}>/dev/null"
  },
  "&null": {
    "prefix": "&null",
    "body": "&>/dev/null"
  },
  "fish_trace": {
    "prefix": "fish_trace",
    "body": "set -l fish_trace 1"
  },
  "argv": {
    "prefix": "argv",
    "body": "\\$argv"
  },
  "argv_index": {
    "prefix": "argv_index",
    "body": "\\$argv[${1:1}]"
  },
  "return": {
    "prefix": "return",
    "body": "return ${1:0}"
  },
  "sdir": {
    "prefix": "sdir",
    "body": "set -lx DIR \"\\$(builtin cd \"\\$(builtin path dirname -- \"\\$(builtin path resolve -- \"\\$(builtin status filename)\")\")\" &>/dev/null && builtin pwd -P)\""
  }
}
