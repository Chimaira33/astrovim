{
  "preprint": {
    "prefix": "preprint",
    "body": "/data/data/com.termux/files/usr"
  },
  "homeprint": {
    "prefix": "homeprint",
    "body": "/data/data/com.termux/files/home"
  },
  "vim": {
    "prefix": "_vim:",
    "body": "${1:vim:} ft=sh:"
  },
  "shift_width": {
    "prefix": "_sw:",
    "body": "${1:vim:} ft=sh:sw=2:ts=2:sts=2:"
  }
}
